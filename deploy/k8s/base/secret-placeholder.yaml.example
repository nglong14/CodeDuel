# This file exists only so `kubectl kustomize` / `kustomize build` can render
# a complete, schema-valid manifest set in CI and in local dry runs, since
# every base Deployment references `codeduel-secrets` via secretRef.
apiVersion: v1
kind: Secret
metadata:
  name: codeduel-secrets
  annotations:
    codeduel.example/placeholder: "true"
type: Opaque
stringData:
  JWT_SECRET: placeholder-not-a-real-secret-please-replace
  POSTGRES_DSN: postgres://codeduel:codeduel@localhost:5433/codeduel?sslmode=disable
  REDIS_URL: redis://localhost:6379/0
