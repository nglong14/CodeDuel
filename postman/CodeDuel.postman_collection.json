      "name": "WebSocket",
      "description": "Use Postman's WebSocket request (Connect). After 101, paste a message from this folder into the composer.\n\nMVP echo: join_queue is echoed; submit_code is acked as judging; unknown types return error.",
      "item": [
        {
          "name": "Connect with Bearer JWT",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{wsUrl}}/ws",
            "description": "Preferred path (duelcli). Collection pre-request mints {{jwt}}.\n\nAfter connect, send:\n```json\n{\"type\":\"join_queue\"}\n```"
          }
        },
        {
          "name": "Connect with query token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{wsUrl}}/ws?token={{jwt}}",
            "description": "Fallback for clients that cannot set headers on a WebSocket handshake (browsers)."
          }
        },
        {
          "name": "Message: join_queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"join_queue\"\n}"
            },
            "url": "{{wsUrl}}/ws",
            "description": "Copy the body into an open WebSocket connection. Do not Send as HTTP. Expected MVP reply: the same join_queue envelope."
          }
        },
