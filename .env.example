POSTGRES_DSN=postgres://codeduel:codeduel@localhost:5433/codeduel?sslmode=disable
# REDIS_URL takes precedence when set. Use redis:// for auth/db selection or
# rediss:// for TLS (system CA pool). REDIS_ADDR is the local-development fallback.
# REDIS_URL=rediss://:password@redis.example.com:6379/0
REDIS_ADDR=localhost:6379
MATCH_DURATION=10m
SUBMISSION_DISPATCH_INTERVAL=5s
SUBMISSION_REENQUEUE_AFTER=30s
LOG_LEVEL=info
LOG_FORMAT=text
APP_ENV=development
GATEWAY_ADDR=:8080
JWT_SECRET=codeduel-dev-secret
AUTH_TOKEN_TTL=24h
JUDGE_CONCURRENCY=2
JUDGE_MAX_CODE_BYTES=65536
JUDGE_MAX_OUTPUT_BYTES=1048576
JUDGE_COMPILE_TIMEOUT=10s
JUDGE_TEST_TIMEOUT=5s
JUDGE_TOTAL_TIMEOUT=30s
JUDGE_CLEANUP_TIMEOUT=10s
JUDGE_ATTEMPT_LEASE=1m
JUDGE_CPU_NANOS=1000000000
JUDGE_MEMORY_BYTES=268435456
JUDGE_MEMORY_SWAP_BYTES=268435456
JUDGE_PID_LIMIT=64
JUDGE_WORKSPACE_BYTES=67108864
JUDGE_TMPFS_BYTES=16777216
JUDGE_PYTHON_IMAGE=codeduel/sandbox-python:3.13
JUDGE_CPP_IMAGE=codeduel/sandbox-cpp:gcc14
JUDGE_JAVA_IMAGE=codeduel/sandbox-java:temurin21
# Empty uses the Docker daemon default (runc). Set runsc only on hosts with gVisor installed.
JUDGE_SANDBOX_RUNTIME=
# Sandbox backend: "docker" (default, local Compose) or "kubernetes" (Phase 7 EKS).
# The JUDGE_K8S_* settings apply only when JUDGE_EXECUTOR=kubernetes.
JUDGE_EXECUTOR=docker
# Namespace Judge creates submission Jobs in (required for kubernetes).
JUDGE_K8S_NAMESPACE=
# RuntimeClass every submission pod requests; the gVisor handler.
JUDGE_K8S_RUNTIME_CLASS=gvisor
# Comma-separated key=value pairs pinning submission pods to the sandbox node
# group. Set to "-" to clear.
JUDGE_K8S_NODE_SELECTOR=sandbox=true
# Toleration for the sandbox node group's NoSchedule taint.
JUDGE_K8S_TOLERATION_KEY=sandbox
JUDGE_K8S_TOLERATION_VALUE=true
REAPER_INTERVAL=10s
REAPER_MAX_ATTEMPTS=3
REAPER_STREAM_MIN_IDLE=2m
REAPER_BATCH_SIZE=32
